\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{forjatex-manual}[2026/11/25 ForjaTeX Official Manual Style]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage[final]{microtype}
\RequirePackage[a4paper,margin=2.2cm,top=2.4cm,bottom=2.4cm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{tcolorbox}
\RequirePackage{lastpage}
\RequirePackage{hyperref}

% Brand palette
\definecolor{fjdark}{HTML}{0F172A}
\definecolor{fjnavy}{HTML}{1E293B}
\definecolor{fjblue}{HTML}{0284C7}
\definecolor{fjsky}{HTML}{38BDF8}
\definecolor{fjslate}{HTML}{475569}
\definecolor{fjmuted}{HTML}{64748B}
\definecolor{fjbg}{HTML}{F8FAFC}
\definecolor{fjborder}{HTML}{CBD5E1}
\definecolor{fjcodebg}{HTML}{F1F5F9}

% Typography & spacing
\linespread{1.22}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlist[itemize]{leftmargin=1.4em, itemsep=3pt, topsep=4pt}
\setlist[enumerate]{leftmargin=1.5em, itemsep=4pt, topsep=4pt}
\setlist[description]{leftmargin=1.2em, itemsep=4pt, topsep=4pt, style=nextline}

% Inline code styling
\newcommand{\code}[1]{\colorbox{fjcodebg}{\texttt{\color{fjdark}\small #1}}}

% Clean native running headers & footers (no fancyhdr required)
\makeatletter
\def\fj@docname{ForjaTeX}
\def\fj@docver{}
\newcommand{\setmanualmeta}[2]{\def\fj@docname{#1}\def\fj@docver{#2}}

\def\ps@forjatex{%
  \def\@oddhead{\small\color{fjmuted}\textbf{\color{fjdark}\fj@docname}\hfill\fj@docver}%
  \def\@evenhead{\@oddhead}%
  \def\@oddfoot{\small\color{fjmuted}Jean Pimenta $\cdot$ Arkhé Code $\cdot$ \href{https://forjatex.com.br}{forjatex.com.br}\hfill \thepage\ / \pageref{LastPage}}%
  \def\@evenfoot{\@oddfoot}%
}
\pagestyle{forjatex}

% Styled section headings while preserving \tableofcontents & hyperref bookmarks
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-18pt \@plus -4pt \@minus -2pt}%
  {8pt \@plus 2pt}%
  {\Large\bfseries\color{fjdark}}}

\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-12pt \@plus -2pt \@minus -1pt}%
  {5pt \@plus 1pt}%
  {\large\bfseries\color{fjblue}}}

% Add subtle blue section numbers
\renewcommand{\@seccntformat}[1]{{\color{fjblue}\csname the#1\endcsname}\quad}
\makeatother

% Callout boxes
\newtcolorbox{fjcallout}[1][]{%
  colback=fjbg,
  colframe=fjblue,
  boxrule=0.8pt,
  leftrule=3.5pt,
  arc=3pt,
  left=10pt,
  right=10pt,
  top=8pt,
  bottom=8pt,
  fonttitle=\bfseries\color{fjdark},
  coltitle=fjdark,
  colbacktitle=fjbg,
  title={#1}
}

% Hero cover header block
\newcommand{\ForjaHeader}[6]{%
  % #1: icon path, #2: ecosystem badge, #3: title, #4: subtitle, #5: version, #6: links/author
  \setmanualmeta{#3}{#5}%
  \thispagestyle{empty}%
  \begin{tcolorbox}[
    colback=fjdark,
    colframe=fjdark,
    arc=6pt,
    left=16pt,
    right=16pt,
    top=16pt,
    bottom=16pt,
    boxrule=0pt
  ]
    \begin{minipage}[c]{0.16\linewidth}
      \includegraphics[width=2.1cm]{#1}
    \end{minipage}%
    \hfill
    \begin{minipage}[c]{0.81\linewidth}
      {\small\bfseries\color{fjsky}\MakeUppercase{#2}}\\[4pt]
      {\LARGE\bfseries\color{white}#3}\\[5pt]
      {\normalsize\color{fjborder}#4}\\[10pt]
      \colorbox{fjblue}{\textbf{\color{white}\small\ #5\ }}\quad
      {\small\color{fjborder}#6}
    \end{minipage}
  \end{tcolorbox}
  \vspace{6pt}
}

% Clean Table of Contents box
\newcommand{\ForjaTOC}[1]{%
  \begin{tcolorbox}[
    colback=fjbg,
    colframe=fjborder,
    arc=4pt,
    boxrule=0.6pt,
    left=12pt,
    right=12pt,
    top=8pt,
    bottom=10pt
  ]
    {\large\bfseries\color{fjdark}#1}\\[4pt]
    \vspace{-10pt}
    \makeatletter
    \@starttoc{toc}
    \makeatother
  \end{tcolorbox}
  \vspace{8pt}
}

