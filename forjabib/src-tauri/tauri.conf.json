{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForjaBib",
  "version": "1.0.3",
  "identifier": "dev.forjatex.forjabib",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ForjaBib — Gerenciador de Bibliografias BibTeX & BibLaTeX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

